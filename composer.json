{
  "name": "riverline/openweathermap-bundle",
  "description": "Webrivage OpenWeatherMap Bundle for Symfony",
  "keywords": ["webrivage", "riverline", "openweathermap", "open", "weather", "map", "symfony", "bundle"],
  "type":"library",
  "license":"MIT",
  "authors":[
    {
      "name":"Romain Cambien",
      "email":"romain@webrivage.com"
    },
    {
      "name":"Julien Bandelier",
      "email":"julien.bandelier@webrivage.com"
    }
  ],
  "homepage": "https://github.com/Riverline/openweathermap-bundle",
  "require": {
    "php": ">=8.2",
    "cmfcmf/openweathermap-php-api": "^2.4",
    "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
    "symfony/config": "^6.4 || ^7.4 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/filesystem": "^6.4 || ^7.4 || ^8.0"
  },
  "autoload": {
    "psr-0": {
      "Riverline\\OpenWeatherMapBundle": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Riverline\\OpenWeatherMapBundle\\Tests\\": "tests/"
    }
  }
}
